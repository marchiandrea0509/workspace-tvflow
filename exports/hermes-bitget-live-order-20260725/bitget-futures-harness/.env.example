# Copy this file to .env.local and insert your own credentials.
# Never share or commit .env.local.
BITGET_API_KEY=PASTE_API_KEY_HERE
BITGET_API_SECRET=PASTE_API_SECRET_HERE
BITGET_API_PASSPHRASE=PASTE_API_PASSPHRASE_HERE

# Start in demo mode.
BITGET_ENV=demo
BITGET_PAPTRADING=1
BITGET_API_BASE_URL=https://api.bitget.com
BITGET_LOCALE=en-US
BITGET_PRODUCT_TYPE=USDT-FUTURES
BITGET_MARGIN_COIN=USDT
BITGET_DEFAULT_SYMBOL=BTCUSDT
BITGET_DEFAULT_MARGIN_MODE=isolated
BITGET_DEFAULT_LEVERAGE=3

# Keep both false until the user explicitly authorizes the exact live action.
BITGET_ALLOW_ORDER_PLACEMENT=false
BITGET_ALLOW_LIVE_TRADING=false

# Protect against host clock drift.
BITGET_USE_SERVER_TIME=true
BITGET_SERVER_TIME_CACHE_MS=300000

# Hermes journal delivery: set in the process environment, not in shared files.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
